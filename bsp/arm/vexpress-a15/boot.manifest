# zuzu initrd boot manifest v3
# format: <program>|<role>[:flags]
# role: none, file   flags: late
# "file" is packed into the initrd but never spawned.

bin/rootsvc

bin/ttysvc|none
bin/pl011drv|none
bin/pl181drv|none
bin/fsd|none
bin/lan9118drv|none
bin/netd|none
bin/pl111drv|none
bin/zzsh|none:late

# Syscall regression suite (user/test_apps/zztest). Noisy: it faults kittens on purpose.
# bin/zztest|none
