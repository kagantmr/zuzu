# zuzu initrd boot manifest v3
# format: <program-or-path>|<role>[:flags][|<service-path>]
# role: tty, none, file   flags: late
# "file" is packed into the initrd but never spawned.

bin/rootsvc.zxf

# bin/pl011drv|tty|/dev/uart0
# bin/pl181drv|none|/dev/mmc0
# bin/fsd|none|/svc/fsd
# bin/lan9118drv|none|/dev/eth0
# bin/netd|none|/svc/netd
# bin/zzsh|tty:late|/env/zzsh
