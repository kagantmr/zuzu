# zuzu initrd boot manifest v3
# format: <program>|<role>[:flags][|<service-path>]
# a service-path is awaited in nsvc before any "late" entry is spawned
# role: none, file   flags: late, prio=N, maxprio=N (comma separated)
# "file" is packed into the initrd but never spawned.

bin/rootsvc

bin/ttysvc|none:prio=2,maxprio=2|/svc/tty
bin/pl011drv|none:prio=2,maxprio=2
bin/pl181drv|none:prio=3,maxprio=3|/dev/mmc0
bin/fsd|none:prio=3,maxprio=3|/svc/fsd
bin/zzsh|none:late

# Everything else is spawned from the SD card: see services.manifest.

# Syscall regression suite (user/test_apps/zztest). Noisy: it faults kittens on purpose.
# bin/zztest|none
