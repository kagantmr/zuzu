# Makefile.user - user programs: tier-1 (zcrt libc) and tier-2 (newlib).

# ---- user (tier-1, zuzu libc) flags ----------------------------------------
USER_LIBGCC = $(shell $(USER_CC) $(CPUFLAGS) $(ARCH_USER_FP) -print-libgcc-file-name)

USER_CFLAGS  = -ffreestanding -nostdlib -O$(USER_OPTIMIZATION_LEVEL) -Wall -Wextra -Wshadow \
               $(CPUFLAGS) $(INCLUDES) -MMD -MP -g $(ARCH_USER_FP) \
               -DBOARD_LAYOUT_H='"$(BOARD_LAYOUT_H)"' -DLOG_LEVEL=$(LOG_LEVEL)
USER_LDFLAGS = -nostdlib -Wl,-T,user/user.ld

ifeq ($(DEBUG_BUILD), 1)
    USER_CFLAGS += -DDEBUG
else
    USER_CFLAGS += -DNDEBUG
endif
ifneq ($(ZUZU_BENCH), 0)
    USER_CFLAGS += -DZUZU_BENCH
endif

# ---- tier-2 (newlib) flags --------------------------------------------------
# Newlib's headers must win over include/, but <zuzu/...> must still resolve.
# This dir exposes zuzu/ alone. (Goes away with the klib/ split.)
NEWLIB_INC = build/newlib-include

NEWLIB_USER_CFLAGS = -O$(USER_OPTIMIZATION_LEVEL) -Wall -Wextra -mthumb \
                     $(CPUFLAGS) -I. -I$(NEWLIB_INC) -Iarch/include -Iarch/$(ARCH)/include \
                     -MMD -MP -g $(ARCH_USER_FP) \
                     -DBOARD_LAYOUT_H='"$(BOARD_LAYOUT_H)"'

# C-only additions: -include force-includes C declarations, which breaks
# crt0-newlib.o's assembler compile (also built with NEWLIB_USER_CFLAGS,
# via -x assembler-with-cpp) if added above. Only used by the two C compile
# rules below.
NEWLIB_USER_CFLAGS_C = $(NEWLIB_USER_CFLAGS) \
                        -include include/newlib_compat.h -DSSIZE_MAX=0x7fffffff

NEWLIB_USER_LDFLAGS = -nostartfiles -Wl,-T,user/user.ld \
                      -mthumb $(CPUFLAGS) $(ARCH_USER_FP)

# Fails only when a tier-2 recipe actually runs, so kernel/tier-1-only
# builds on a machine without a newlib toolchain are unaffected.
define check-newlib-toolchain
	@if [ -z "$(NEWLIB_CROSS)" ]; then \
		echo "  ERROR   no newlib-capable arm-none-eabi-gcc found for tier-2 build."; \
		echo "          install one (e.g. Arm GNU Toolchain) or set NEWLIB_CROSS=/path/to/arm-none-eabi-"; \
		exit 1; \
	fi
endef

# ---- user programs ----------------------------------------------------------
# A program is any user/<group>/<prog>/ with a build.mk declaring:
#   prog-y    := <name>        ELF/initrd name (defaults to the directory name)
#   prog-tier := zcrt|newlib   which libc it links against
# or, for a static archive:
#   lib-y     := <name>
#
# <group> is organisational only. What gets packaged where is the board's
# call, not the directory's -- see BOOT_PROGS/SD_PROGS below.
USER_PROG_DIRS := $(patsubst %/build.mk,%,$(wildcard user/*/*/build.mk))

define read-prog
prog-y :=
prog-tier :=
lib-y :=
include $(1)/build.mk
ifneq ($$(lib-y),)
LIB_PROGS += $$(lib-y)
USER_DIR_$$(lib-y) := $(1)
else
_prog := $$(if $$(prog-y),$$(prog-y),$$(notdir $(1)))
USER_PROGS += $$(_prog)
USER_DIR_$$(_prog) := $(1)
USER_TIER_$$(_prog) := $$(if $$(prog-tier),$$(prog-tier),zcrt)
endif
endef

USER_PROGS :=
LIB_PROGS  :=
$(foreach d,$(USER_PROG_DIRS),$(eval $(call read-prog,$(d))))

NEWLIB_PROGS := $(foreach p,$(USER_PROGS),$(if $(filter newlib,$(USER_TIER_$(p))),$(p)))
ZCRT_PROGS   := $(filter-out $(NEWLIB_PROGS),$(USER_PROGS))

# ---- packaging is per board --------------------------------------------------
# The board's boot.manifest doubles as the initrd packing list and the runtime
# spawn list; sd.manifest lists what goes on the SD card. A program appears
# because a board asked for it, not because of where its source lives.
BOOT_MANIFEST := $(BOARD_DIR)/boot.manifest
SD_MANIFEST   := $(BOARD_DIR)/sd.manifest

# First |-field of each non-comment, non-blank line, basename only:
# "bin/zzsh|tty:late|/env/zzsh" -> zzsh
manifest-progs = $(sort $(notdir $(shell awk -F'|' \
  '/^[[:space:]]*#/ || /^[[:space:]]*$$/ { next } \
   { gsub(/[[:space:]]/, "", $$1); if ($$1 != "") print $$1 }' $(1) 2>/dev/null)))

BOOT_PROGS := $(call manifest-progs,$(BOOT_MANIFEST))
SD_PROGS   := $(call manifest-progs,$(SD_MANIFEST))

$(foreach p,$(BOOT_PROGS) $(SD_PROGS),$(if $(USER_DIR_$(p)),,\
  $(error $(p) is listed in a manifest for BOARD=$(BOARD) but no \
    user/*/$(p)/build.mk declares it)))

$(foreach p,$(USER_PROGS) $(LIB_PROGS),\
  $(eval USER_$(p)_SRCS := $(shell find $(USER_DIR_$(p)) -name '*.c')))
$(foreach p,$(USER_PROGS) $(LIB_PROGS),\
  $(eval USER_$(p)_OBJS := $(patsubst user/%.c,$(O)/user/%.o,$(USER_$(p)_SRCS))))

# Only build what this board actually packages.
BOARD_PROGS   := $(sort $(BOOT_PROGS) $(SD_PROGS))
USER_APP_OBJS := $(foreach p,$(BOARD_PROGS),$(USER_$(p)_OBJS))
LIB_PROG_OBJS := $(foreach p,$(LIB_PROGS),$(USER_$(p)_OBJS))

# zcrt: the user-side runtime for tier-1 — klib rebuilt with user flags, the
# ZCRT libc (lib/), and the IPC runtime (lib/zuzu/). klib/arm/*.S (hand-tuned
# memcpy/memset) is picked up separately -- it's not covered by the flat
# klib/*.c wildcard, and needs its own .S compile rule below.
ZCRT_CSRCS := $(wildcard klib/*.c lib/*.c lib/zuzu/*.c lib/zuzu/sync/*.c)
ZCRT_SSRCS := $(shell find klib -name '*.S')
ZCRT_SRCS  := $(ZCRT_CSRCS) $(ZCRT_SSRCS)
ZCRT_OBJS  := $(patsubst %.c,$(O)/user/zcrt/%.o,$(ZCRT_CSRCS)) \
              $(patsubst %.S,$(O)/user/zcrt/%.o,$(ZCRT_SSRCS))

ZCRT_ARCHIVE = $(O)/user/libc.a
$(ZCRT_ARCHIVE): $(ZCRT_OBJS)
	@mkdir -p $(dir $@)
	@echo "  AR      $@"
	@rm -f $@
	@$(USER_AR) rcs $@ $(ZCRT_OBJS)

# Tier-2 zcrt allowlist: the IPC runtime plus zuzu's sbrk arena — and
# nothing else, so newlib owns every libc symbol (string/mem/stdio/...)
# unambiguously. sbrk.c must be here explicitly: the _sbrk stub calls
# sbrk(), and without this object the linker pulls newlib's sbrk() from
# libc.a, which calls _sbrk_r -> _sbrk -> sbrk: unbounded recursion that
# runs the stack into the guard page on the first malloc.
NEWLIB_ZCRT_SRCS := $(wildcard lib/zuzu/*.c lib/zuzu/sync/*.c) lib/sbrk.c
NEWLIB_ZCRT_OBJS := $(patsubst %.c,$(O)/user/zcrt/%.o,$(NEWLIB_ZCRT_SRCS))
NEWLIB_STUB_SRCS := $(wildcard lib/posix/*.c)
NEWLIB_STUB_OBJS := $(patsubst lib/%.c,$(O)/lib/%.o,$(NEWLIB_STUB_SRCS))

USER_CRT0             = $(O)/user/crt0.o
NEWLIB_CRT0           = $(O)/user/crt0-newlib.o
BOOT_PROG_PACKED_ELFS = $(BOOT_PROGS:%=$(O)/user/%.stripped.elf)
SD_PROG_PACKED_ELFS   = $(SD_PROGS:%=$(O)/user/%.stripped.elf)
SD_LIBS               = $(LIB_PROGS)
SD_LIB_ARCHIVES       = $(SD_LIBS:%=$(O)/user/lib/%.a)

ALL_USER_ELFS = $(BOARD_PROGS:%=$(O)/user/%.elf)

USER_DEPS = $(USER_CRT0:.o=.d) $(NEWLIB_CRT0:.o=.d) $(USER_APP_OBJS:.o=.d) \
            $(LIB_PROG_OBJS:.o=.d) $(ZCRT_OBJS:.o=.d) $(NEWLIB_STUB_OBJS:.o=.d)

.SECONDARY: $(USER_APP_OBJS) $(LIB_PROG_OBJS) $(ZCRT_OBJS)

# ---- compilation rules ------------------------------------------------------
$(NEWLIB_INC)/zuzu:
	@mkdir -p $(NEWLIB_INC)
	@ln -sfn ../../include/zuzu $(NEWLIB_INC)/zuzu

# This newlib build's own <dirent.h> hard #errors on this target (no host
# directory backend), so shadow it with our own (see lib/posix/dirent.c).
$(NEWLIB_INC)/dirent.h:
	@mkdir -p $(NEWLIB_INC)
	@ln -sfn ../../include/dirent.h $(NEWLIB_INC)/dirent.h

NEWLIB_INC_STAMPS = $(NEWLIB_INC)/zuzu $(NEWLIB_INC)/dirent.h

$(O)/user/newlib_apps/%.o: user/newlib_apps/%.c $(FLAGS_STAMP) $(NEWLIB_INC_STAMPS)
	$(call check-newlib-toolchain)
	@mkdir -p $(dir $@)
	@echo "  CC[nl]  $<"
	@$(NEWLIB_CC) $(NEWLIB_USER_CFLAGS_C) -c $< -o $@
	@$(call record-cmd,$(NEWLIB_CC) $(NEWLIB_USER_CFLAGS_C) -c $< -o $@)

$(O)/lib/posix/%.o: lib/posix/%.c $(FLAGS_STAMP) $(NEWLIB_INC_STAMPS)
	$(call check-newlib-toolchain)
	@mkdir -p $(dir $@)
	@echo "  CC[nl]  $<"
	@$(NEWLIB_CC) $(NEWLIB_USER_CFLAGS_C) -c $< -o $@
	@$(call record-cmd,$(NEWLIB_CC) $(NEWLIB_USER_CFLAGS_C) -c $< -o $@)

$(O)/user/%.o: user/%.c $(FLAGS_STAMP)
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(USER_CC) $(USER_CFLAGS) -c $< -o $@
	@$(call record-cmd,$(USER_CC) $(USER_CFLAGS) -c $< -o $@)

$(O)/user/zcrt/%.o: %.c $(FLAGS_STAMP)
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(USER_CC) $(USER_CFLAGS) -c $< -o $@
	@$(call record-cmd,$(USER_CC) $(USER_CFLAGS) -c $< -o $@)

$(O)/user/zcrt/%.o: %.S $(FLAGS_STAMP)
	@mkdir -p $(dir $@)
	@echo "  AS      $<"
	@$(USER_CC) $(USER_CFLAGS) -x assembler-with-cpp -c $< -o $@
	@$(call record-cmd,$(USER_CC) $(USER_CFLAGS) -x assembler-with-cpp -c $< -o $@)

$(USER_CRT0): $(ARCH_DIR)/crt0.S
	@mkdir -p $(dir $@)
	@echo "  AS      $<"
	@$(USER_CC) $(USER_CFLAGS) -x assembler-with-cpp -c $< -o $@
	@$(call record-cmd,$(USER_CC) $(USER_CFLAGS) -x assembler-with-cpp -c $< -o $@)

$(NEWLIB_CRT0): $(ARCH_DIR)/crt0.S
	$(call check-newlib-toolchain)
	@mkdir -p $(dir $@)
	@echo "  AS[nl]  $<"
	@$(NEWLIB_CC) $(NEWLIB_USER_CFLAGS) -DZUZU_NEWLIB -x assembler-with-cpp -c $< -o $@
	@$(call record-cmd,$(NEWLIB_CC) $(NEWLIB_USER_CFLAGS) -DZUZU_NEWLIB -x assembler-with-cpp -c $< -o $@)

# ---- user program link rules ------------------------------------------------
define LINK_USER_PROG
$(O)/user/$(1).elf: $$(USER_$(1)_OBJS) $(USER_CRT0) $(ZCRT_OBJS) user/user.ld
	@mkdir -p $$(dir $$@)
	@echo "  LD      $$@"
	@$(USER_LD) $(USER_LDFLAGS) $(USER_CRT0) $$(USER_$(1)_OBJS) $(ZCRT_OBJS) $(USER_LIBGCC) -o $$@
endef

$(foreach p,$(filter $(ZCRT_PROGS),$(BOARD_PROGS)),$(eval $(call LINK_USER_PROG,$(p))))

define LINK_NEWLIB_PROG
$(O)/user/$(1).elf: $$(USER_$(1)_OBJS) $(NEWLIB_CRT0) $(NEWLIB_STUB_OBJS) $(NEWLIB_ZCRT_OBJS) user/user.ld
	$$(call check-newlib-toolchain)
	@mkdir -p $$(dir $$@)
	@echo "  LD[nl]  $$@"
	@$(NEWLIB_LD) $(NEWLIB_USER_LDFLAGS) $(NEWLIB_CRT0) $$(USER_$(1)_OBJS) $(NEWLIB_STUB_OBJS) $(NEWLIB_ZCRT_OBJS) -o $$@
endef

$(foreach p,$(filter $(NEWLIB_PROGS),$(BOARD_PROGS)),$(eval $(call LINK_NEWLIB_PROG,$(p))))

define LINK_USER_LIB
$(O)/user/lib/$(1).a: $$(USER_$(1)_OBJS)
	@mkdir -p $$(dir $$@)
	@echo "  AR      $$@"
	@rm -f $$@
	@$(USER_AR) rcs $$@ $$(USER_$(1)_OBJS)
endef

$(foreach p,$(LIB_PROGS),$(eval $(call LINK_USER_LIB,$(p))))

$(O)/user/%.stripped.elf: $(O)/user/%.elf
	@echo "  STRIP   $@"
	@$(USER_OBJCOPY) --strip-debug $< $@

# ---- ZXF conversion ----------------------------------------------------------
# Everything in the initrd ships as ZXF: the kernel loads sysd/devmgr directly
# via KernelProcessLoad and sysd's loader (user/services/sysd/exec.c)
# dispatches on magic, so both understand it. SD-card programs stay plain ELF.
ZXF_PROGS = $(BOOT_PROGS)
ZXF_PROG_FILES = $(ZXF_PROGS:%=$(O)/user/%.zxf)

$(O)/user/%.zxf: $(O)/user/%.stripped.elf scripts/elf2zxf.py
	$(call check-tool,python3,install Python 3.)
	@echo "  ZXF     $@"
	@python3 scripts/elf2zxf.py $< -o $@ > /dev/null
