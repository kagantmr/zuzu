# zuzu documentation: strict. Every function (static ones too), struct, field,
# enum value, typedef, parameter and return value in scope must be documented;
# any warning fails the build. INPUT comes from the ratchet list in
# docs/doc-scope (see `make doc-check` / `make doc-report`).

PROJECT_NAME           = zuzu
PROJECT_BRIEF          = "the Scottish Fold microkernel"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TYPEDEF_HIDES_STRUCT   = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
TAB_SIZE               = 4

EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PRIVATE        = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

INPUT                  = $(ZUZU_DOC_INPUT)
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
EXCLUDE_SYMLINKS       = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include arch/include arch/arm/include
PREDEFINED             = __zuzu__ \
                         __DOXYGEN__ \
                         __ZUZU__ \
                         CONFIG_ZUZU_BENCH \
                         DEBUG \
                         _Atomic(x)=x \
                         __attribute__(x)= \
                         __always_inline=inline \
                         __hot= \
                         __cold= \
                         likely(x)=x \
                         unlikely(x)=x

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = docs/doxygen/warnings.log

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
XML_NS_MEMB_FILE_SCOPE = NO
HAVE_DOT               = NO

ALIASES += "syscall_num=@xrefitem syscall_num \"Syscall number\" \"\" "
ALIASES += "syscall_group=@xrefitem syscall_group \"Syscall group\" \"\" "
ALIASES += "syscall_blocking=@xrefitem syscall_blocking \"Blocking\" \"\" "
ALIASES += "syscall_sig=@xrefitem syscall_sig \"Signature\" \"\" "
ALIASES += "reg{3}=@param \2 (\1) \3"
