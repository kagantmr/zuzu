# zuzu initrd boot manifest v1
# format: <program-or-path>|<role>
# role: init, dev, tty, none
# examples: sysd|init, devmgr|dev

bin/sysd|init
bin/devmgr|dev
bin/pl011drv|tty
# bin/pl181drv|none
# bin/fsd|none
# bin/lan9118drv|none
# bin/netd|none
# Not :late -- needs to have registered "sipc" in the nametable well
# before speedtest's (late) cross-process IPC benchmark looks it up.
bin/speedtest_ipc_child|none
# bin/zzsh|tty:late
bin/speedtest|none:late
